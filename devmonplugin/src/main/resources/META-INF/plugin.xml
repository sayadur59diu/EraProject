<idea-plugin>
    <id>com.devmonplugin</id>
    <name>DevMon Plugin</name>
    <version>1.0</version>

    <vendor email="sayadur@erainfotechbd.com" url="https://www.erainfotechbd.com/">
        Md. Sayadur Rahaman
    </vendor>

    <description>
        Tracks developer activity (file edits, project usage) and sends logs to Spring Boot.
    </description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <editorFactoryListener
                implementation="com.devmonplugin.EditorActivityListener"/>
    </extensions>
</idea-plugin>